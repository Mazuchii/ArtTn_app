<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane style="-fx-background-color: #f4f7f6;"
            stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.museum.controllers.UserDonationsController">

    <BorderPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <top>
            <VBox>
                <HBox alignment="CENTER_LEFT" spacing="20.0"
                      style="-fx-background-color: #1a1a2e; -fx-padding: 15 25;">
                    <Label text="MUSEUM DIGITAL"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="userWelcomeLabel" text="Bienvenue"
                           style="-fx-text-fill: #D4AF37; -fx-font-weight: bold;" />
                    <Button onAction="#handleBackToEvents" text="Evenements"
                            style="-fx-background-color: transparent; -fx-text-fill: #D4AF37;
                                   -fx-font-weight: bold; -fx-cursor: hand;" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0"
                      style="-fx-background-color: white; -fx-padding: 12 25;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                    <Label text="Mes Donations"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleRefresh" text="Actualiser"
                            style="-fx-background-color: #D4AF37; -fx-text-fill: #1a1a2e;
                                   -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 20;
                                   -fx-cursor: hand;" />
                </HBox>
            </VBox>
        </top>

        <center>
            <ScrollPane fitToWidth="true" fitToHeight="true"
                        style="-fx-background: #f4f7f6; -fx-background-color: #f4f7f6;
                               -fx-border-color: transparent;">
                <VBox spacing="20.0" maxWidth="1.7976931348623157E308"
                      style="-fx-padding: 25; -fx-background-color: #f4f7f6;">
                    <Label text="Vos sponsorings actifs"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                    <Label fx:id="emptyLabel" text="Vous n'avez pas encore de donation active."
                           visible="false" managed="false"
                           style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;" />
                    <TableView fx:id="donationsTable" VBox.vgrow="ALWAYS"
                               maxWidth="1.7976931348623157E308" prefHeight="520"
                               style="-fx-background-color: white; -fx-border-color: transparent;">
                        <columns>
                            <TableColumn fx:id="eventTitleColumn" prefWidth="260" text="Evenement" />
                            <TableColumn fx:id="packNameColumn" prefWidth="220" text="Pack" />
                            <TableColumn fx:id="amountColumn" prefWidth="140" text="Montant" />
                            <TableColumn fx:id="statusColumn" prefWidth="140" text="Statut" />
                            <TableColumn fx:id="dateColumn" prefWidth="160" text="Date" />
                        </columns>
                    </TableView>
                    <Button onAction="#handleBackToEvents" text="Retour au catalogue"
                            style="-fx-background-color: #D4AF37; -fx-text-fill: #1a1a2e;
                                   -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 20;" />
                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>
</AnchorPane>
