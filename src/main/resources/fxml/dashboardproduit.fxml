<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.museum.controllers.DashboardProduitController">

    <!-- TOP BAR -->
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: linear-gradient(to right, #1a1a2e, #16213e); -fx-padding: 15;">
                <children>
                    <Label text="🏛️ MUSEUM DIGITAL" textFill="white">
                        <font><Font name="System Bold" size="20.0" /></font>
                    </Label>
                    <Label text="| Administration Produits et Commandes" textFill="#d4af37">
                        <font><Font size="14.0" /></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="welcomeLabel" text="Administrateur" textFill="white" />
                    <Button onAction="#handleLogout" style="-fx-background-color: #d4af37; -fx-text-fill: #2c3e50; -fx-background-radius: 5; -fx-font-weight: bold;" text="🚪 Déconnexion" />
                </children>
            </HBox>
        </VBox>
    </top>

    <!-- LEFT MENU -->
    <left>
        <VBox prefWidth="220.0" spacing="10.0" style="-fx-background-color: #2c3e50; -fx-padding: 20 10;">
            <children>
                <!-- Statistiques -->
                <VBox spacing="5.0" style="-fx-padding: 10; -fx-background-color: #34495e; -fx-background-radius: 10;">
                    <children>
                        <Label text="📊 STATISTIQUES" textFill="#95a5a6" style="-fx-font-size: 11px;" />
                        <Label fx:id="statsProducts" text="Produits: 0" textFill="white" style="-fx-font-weight: bold;" />
                        <Label fx:id="statsOrders" text="Commandes: 0" textFill="white" style="-fx-font-weight: bold;" />
                        <Label fx:id="statsPending" text="En attente: 0" textFill="#f39c12" />
                    </children>
                </VBox>

                <Separator />

                <!-- Menu -->
                <Button onAction="#showProductsPanel" style="-fx-background-color: #d4af37; -fx-text-fill: #2c3e50; -fx-background-radius: 8; -fx-font-weight: bold;" text="🛍️ Produits" />
                <Button onAction="#showOrdersPanel" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-background-radius: 8;" text="📦 Commandes" />
            </children>
        </VBox>
    </left>

    <!-- CENTER - STACK PANEL -->
    <center>
        <StackPane>

            <!-- ==================== PANEL PRODUITS ==================== -->
            <VBox fx:id="productsPanel" spacing="15.0" style="-fx-padding: 20; -fx-background-color: #f5f5f5;">
                <children>
                    <!-- Titre -->
                    <HBox alignment="CENTER_LEFT">
                        <children>
                            <Label text="🛍️ Gestion des Produits" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#handleAddProduct" style="-fx-background-color: #d4af37; -fx-text-fill: #2c3e50; -fx-background-radius: 5; -fx-font-weight: bold;" text="+ Ajouter un produit" />
                        </children>
                    </HBox>

                    <!-- Filtres -->
                    <HBox spacing="15.0">
                        <children>
                            <TextField fx:id="productSearchField" promptText="🔍 Rechercher..." prefHeight="35.0" prefWidth="250.0" style="-fx-background-radius: 20; -fx-padding: 0 15;" />
                            <ComboBox fx:id="categoryFilter" prefWidth="150.0" prefHeight="35.0" promptText="Toutes catégories" style="-fx-background-radius: 20;" />
                        </children>
                    </HBox>

                    <!-- Tableau des produits -->
                    <TableView fx:id="productsTable" prefHeight="450.0" style="-fx-background-radius: 10;">
                        <columns>
                            <TableColumn fx:id="productIdColumn" prefWidth="50.0" text="ID" />
                            <TableColumn fx:id="productNameColumn" prefWidth="200.0" text="Nom" />
                            <TableColumn fx:id="productDescColumn" prefWidth="250.0" text="Description" />
                            <TableColumn fx:id="productPriceColumn" prefWidth="80.0" text="Prix" />
                            <TableColumn fx:id="productStockColumn" prefWidth="80.0" text="Stock" />
                            <TableColumn fx:id="productCategoryColumn" prefWidth="120.0" text="Catégorie" />
                            <TableColumn fx:id="productStatusColumn" prefWidth="100.0" text="Statut" />
                        </columns>
                    </TableView>

                    <!-- Actions produits -->
                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <children>
                            <Button onAction="#handleEditProduct" style="-fx-background-color: #d4af37; -fx-text-fill: #2c3e50; -fx-background-radius: 5; -fx-font-weight: bold;" text="✏️ Modifier" />
                            <Button onAction="#handleDeleteProduct" style="-fx-background-color: #d4af37; -fx-text-fill: #2c3e50; -fx-background-radius: 5; -fx-font-weight: bold;" text="🗑️ Supprimer" />
                        </children>
                    </HBox>
                </children>
            </VBox>

            <!-- ==================== PANEL COMMANDES ==================== -->
            <VBox fx:id="ordersPanel" spacing="15.0" style="-fx-padding: 20; -fx-background-color: #f5f5f5;" visible="false" managed="false">
                <children>
                    <!-- Titre -->
                    <Label text="📦 Gestion des Commandes" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

                    <!-- Filtres -->
                    <HBox spacing="15.0">
                        <children>
                            <TextField fx:id="orderSearchField" promptText="🔍 Rechercher par ID..." prefHeight="35.0" prefWidth="250.0" style="-fx-background-radius: 20; -fx-padding: 0 15;" />
                            <ComboBox fx:id="statusFilter" prefWidth="150.0" prefHeight="35.0" promptText="Tous statuts" style="-fx-background-radius: 20;" />
                        </children>
                    </HBox>

                    <!-- Tableau des commandes -->
                    <TableView fx:id="ordersTable" prefHeight="300.0" style="-fx-background-radius: 10;">
                        <columns>
                            <TableColumn fx:id="orderIdColumn" prefWidth="80.0" text="N°" />
                            <TableColumn fx:id="orderUserIdColumn" prefWidth="80.0" text="User ID" />
                            <TableColumn fx:id="orderDateColumn" prefWidth="150.0" text="Date" />
                            <TableColumn fx:id="orderTotalColumn" prefWidth="100.0" text="Total" />
                            <TableColumn fx:id="orderStatusColumn" prefWidth="120.0" text="Statut" />
                            <TableColumn fx:id="orderAddressColumn" prefWidth="200.0" text="Adresse" />
                            <TableColumn fx:id="orderPaymentColumn" prefWidth="120.0" text="Paiement" />
                        </columns>
                    </TableView>

                    <!-- Détails commande -->
                    <TitledPane text="Détails de la commande" animated="true" expanded="false">
                        <content>
                            <VBox spacing="10.0" style="-fx-padding: 10;">
                                <children>
                                    <Label fx:id="orderDetailsLabel" text="Sélectionnez une commande" />
                                    <ListView fx:id="orderItemsList" prefHeight="150.0" />
                                </children>
                            </VBox>
                        </content>
                    </TitledPane>

                    <!-- Actions commandes -->
                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <children>
                            <Button fx:id="confirmOrderBtn" onAction="#handleConfirmOrder" style="-fx-background-color: #d4af37; -fx-text-fill: #2c3e50; -fx-background-radius: 5; -fx-font-weight: bold;" text="✅ Confirmer" />
                            <Button fx:id="shipOrderBtn" onAction="#handleShipOrder" style="-fx-background-color: #d4af37; -fx-text-fill: #2c3e50; -fx-background-radius: 5; -fx-font-weight: bold;" text="📦 Expédier" />
                            <Button fx:id="deliverOrderBtn" onAction="#handleDeliverOrder" style="-fx-background-color: #d4af37; -fx-text-fill: #2c3e50; -fx-background-radius: 5; -fx-font-weight: bold;" text="🚚 Livrer" />
                            <Button fx:id="cancelOrderBtn" onAction="#handleCancelOrder" style="-fx-background-color: #d4af37; -fx-text-fill: #2c3e50; -fx-background-radius: 5; -fx-font-weight: bold;" text="❌ Annuler" />
                            <Button onAction="#handleDeleteOrder" style="-fx-background-color: #d4af37; -fx-text-fill: #2c3e50; -fx-background-radius: 5; -fx-font-weight: bold;" text="🗑️ Supprimer" />
                        </children>
                    </HBox>
                </children>
            </VBox>

        </StackPane>
    </center>

</BorderPane>
