<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:id="mainContainer" prefHeight="900.0" prefWidth="1200.0"
            style="-fx-background-color: #F8F5F0;"
            stylesheets="@../css/front.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.museum.controllers.FavoriteOffersController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="front-header">
            <Label text="🏛️ MUSEUM DIGITAL" styleClass="front-header-logo" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="14.0">
                <Button text="Offres d'Emploi" onAction="#handleRetourOffres"
                        styleClass="btn-front-secondary" />
                <Hyperlink text="Mes favoris"
                           style="-fx-text-fill: #D4AF37; -fx-font-weight: bold; -fx-underline: false;" />
                <Button text="Mes candidatures" onAction="#handleOpenMesCandidatures"
                        styleClass="btn-front-secondary" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="tfRecherche" onKeyReleased="#handleRecherche"
                       prefWidth="240.0" promptText="🔍 Rechercher..."
                       styleClass="front-search" />
        </HBox>
    </top>

    <!-- ══ CONTENU ══ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="front-scroll">
            <content>
                <VBox spacing="28.0" style="-fx-padding: 28 40;">

                    <!-- Titre section -->
                    <VBox spacing="10.0">
                        <HBox alignment="BOTTOM_LEFT">
                            <Label text="⭐ Mes Offres Favorites" styleClass="job-section-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblInfo"
                                   style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-font-style: italic;" />
                        </HBox>
                        <Separator />
                    </VBox>

                    <!-- Grille des offres favorites -->
                    <FlowPane fx:id="flowPaneFavoris" hgap="22.0" vgap="22.0"
                              prefWrapLength="1120.0" />

                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- ══ FOOTER — identique à JobFront ══ -->
    <bottom>
        <HBox alignment="CENTER" styleClass="front-footer">
            <Label text="© 2026 Museum Digital — Tous droits réservés"
                   styleClass="front-footer-text" />
        </HBox>
    </bottom>

</BorderPane>
