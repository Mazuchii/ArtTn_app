<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" style="-fx-padding: 20; -fx-background-color: #dae0e6;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.museum.controllers.ForumDashboardController">

    <children>
        <!-- Header avec titre -->
        <HBox alignment="CENTER_LEFT">
            <children>
                <Label text="💬 Gestion du Forum" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="adminLabel" text="👑 Administrateur" style="-fx-text-fill: #d4af37; -fx-font-weight: bold;" />
            </children>
        </HBox>

        <!-- ==================== STATISTIQUES ==================== -->
        <HBox spacing="15.0">
            <children>
                <!-- Posts -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-alignment: center;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="📝" style="-fx-font-size: 30px;" />
                        <Label text="Posts" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px; -fx-font-weight: bold;" />
                        <Label fx:id="statsPosts" text="0" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #2c3e50;" />
                    </children>
                </VBox>

                <!-- Commentaires -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-alignment: center;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="💬" style="-fx-font-size: 30px;" />
                        <Label text="Commentaires" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px; -fx-font-weight: bold;" />
                        <Label fx:id="statsComments" text="0" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #2c3e50;" />                    </children>
                </VBox>

                <!-- Catégories -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-alignment: center;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="🏷️" style="-fx-font-size: 30px;" />
                        <Label text="Catégories" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px; -fx-font-weight: bold;" />
                        <Label fx:id="statsCategories" text="0" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #2c3e50;" />                    </children>
                </VBox>

                <!-- Signalements -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-alignment: center;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="🚩" style="-fx-font-size: 30px;" />
                        <Label text="Signalements" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px; -fx-font-weight: bold;" />
                        <Label fx:id="statsReports" text="0" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #e74c3c;" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- ==================== ONGLETS ==================== -->
        <TabPane VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-tab-header-background: transparent; -fx-border-width: 0;">            <tabs>
                <!-- TAB POSTS -->
                <Tab text="📝 Tous les posts" closable="false">
                    <content>
                        <VBox spacing="15.0" style="-fx-padding: 15;">
                            <children>
                                <HBox spacing="15.0">
                                    <children>
                                        <TextField fx:id="postSearchField" promptText="🔍 Rechercher un post..." style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 8 15; -fx-border-color: #ddd; -fx-border-radius: 25;" HBox.hgrow="ALWAYS" />
                                        <Button onAction="#handleRefreshPosts" style="-fx-background-color: #d4af37; -fx-text-fill: #2c3e50; -fx-background-radius: 5; -fx-font-weight: bold;" text="🔄 Actualiser" />
                                    </children>
                                </HBox>

                                <TableView fx:id="postsTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10;">
                                    <columns>
                                        <TableColumn fx:id="postIdColumn" prefWidth="60.0" text="ID" />
                                        <TableColumn fx:id="postTitleColumn" prefWidth="220.0" text="Titre" />
                                        <TableColumn fx:id="postContentColumn" prefWidth="250.0" text="Contenu" />
                                        <TableColumn fx:id="postDateColumn" prefWidth="130.0" text="Date" />
                                        <TableColumn fx:id="postCommentCountColumn" prefWidth="80.0" text="💬" />
                                        <TableColumn fx:id="postReportCountColumn" prefWidth="80.0" text="🚩" />
                                        <TableColumn fx:id="postActionsColumn" prefWidth="180.0" text="Actions" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <!-- TAB COMMENTAIRES -->
                <Tab text="💬 Tous les commentaires" closable="false">
                    <content>
                        <VBox spacing="15.0" style="-fx-padding: 15;">
                            <children>
                                <HBox spacing="15.0">
                                    <children>
                                        <TextField fx:id="commentSearchField" promptText="🔍 Rechercher un commentaire..." style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 8 15; -fx-border-color: #ddd; -fx-border-radius: 25;" HBox.hgrow="ALWAYS" />
                                        <Button onAction="#handleRefreshComments" style="-fx-background-color: #d4af37; -fx-text-fill: #2c3e50; -fx-background-radius: 5; -fx-font-weight: bold;" text="🔄 Actualiser" />
                                    </children>
                                </HBox>

                                <TableView fx:id="commentsTable" prefHeight="400.0" style="-fx-background-radius: 10;">
                                    <columns>
                                        <TableColumn fx:id="commentIdColumn" prefWidth="60.0" text="ID" />
                                        <TableColumn fx:id="commentPostIdColumn" prefWidth="80.0" text="Post ID" />
                                        <TableColumn fx:id="commentContentColumn" prefWidth="400.0" text="Contenu" />
                                        <TableColumn fx:id="commentActionsColumn" prefWidth="150.0" text="Actions" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <!-- TAB CATÉGORIES -->
                <Tab text="🏷️ Gérer les catégories" closable="false">
                    <content>
                        <VBox spacing="15.0" style="-fx-padding: 15;">
                            <children>
                                <HBox spacing="15.0">
                                    <children>
                                        <TextField fx:id="categorySearchField" promptText="🔍 Rechercher une catégorie..." style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 8 15; -fx-border-color: #ddd; -fx-border-radius: 25;" HBox.hgrow="ALWAYS" />
                                        <Button onAction="#handleAddCategory" style="-fx-background-color: #d4af37; -fx-text-fill: #2c3e50; -fx-background-radius: 5; -fx-font-weight: bold;" text="➕ Ajouter une catégorie" />
                                        <Button onAction="#handleRefreshCategories" style="-fx-background-color: #d4af37; -fx-text-fill: #2c3e50; -fx-background-radius: 5; -fx-font-weight: bold;" text="🔄 Actualiser" />
                                    </children>
                                </HBox>

                                <TableView fx:id="categoriesTable" prefHeight="400.0" style="-fx-background-radius: 10;">
                                    <columns>
                                        <TableColumn fx:id="categoryIdColumn" prefWidth="60.0" text="ID" />
                                        <TableColumn fx:id="categoryIconColumn" prefWidth="80.0" text="Icône" />
                                        <TableColumn fx:id="categoryNameColumn" prefWidth="200.0" text="Nom" />
                                        <TableColumn fx:id="categoryDescColumn" prefWidth="300.0" text="Description" />
                                        <TableColumn fx:id="categoryActionsColumn" prefWidth="150.0" text="Actions" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <!-- TAB SIGNALEMENTS -->
                <Tab text="🚩 Signalements" closable="false">
                    <content>
                        <VBox spacing="15.0" style="-fx-padding: 15;">
                            <children>
                                <HBox spacing="15.0">
                                    <children>
                                        <TextField fx:id="reportSearchField" promptText="🔍 Rechercher un signalement..." style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 8 15; -fx-border-color: #ddd; -fx-border-radius: 25;" HBox.hgrow="ALWAYS" />
                                        <Button onAction="#handleRefreshReports" style="-fx-background-color: #d4af37; -fx-text-fill: #2c3e50; -fx-background-radius: 5; -fx-font-weight: bold;" text="🔄 Actualiser" />
                                    </children>
                                </HBox>

                                <TableView fx:id="reportsTable" prefHeight="400.0" style="-fx-background-radius: 10;">
                                    <columns>
                                        <TableColumn fx:id="reportIdColumn" prefWidth="60.0" text="ID" />
                                        <TableColumn fx:id="reportPostIdColumn" prefWidth="80.0" text="Post ID" />
                                        <TableColumn fx:id="reportPostTitleColumn" prefWidth="200.0" text="Titre du post" />
                                        <TableColumn fx:id="reportReasonColumn" prefWidth="150.0" text="Raison" />
                                        <TableColumn fx:id="reportDetailsColumn" prefWidth="200.0" text="Détails" />
                                        <TableColumn fx:id="reportStatusColumn" prefWidth="100.0" text="Statut" />
                                        <TableColumn fx:id="reportDateColumn" prefWidth="130.0" text="Date" />
                                        <TableColumn fx:id="reportActionsColumn" prefWidth="150.0" text="Actions" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>

        <Label fx:id="messageLabel" style="-fx-text-fill: #e74c3c;" visible="false" />
    </children>
</VBox>
