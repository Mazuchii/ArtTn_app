<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity" prefHeight="-1.0" prefWidth="-1.0" style="-fx-background-color: #e8eef2;" stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.museum.controllers.PackListController">

    <left>
        <VBox prefWidth="260.0" styleClass="sidebar">
            <children>
                <VBox alignment="CENTER" prefHeight="120.0" spacing="10.0">
                    <children>
                        <Label styleClass="logo-icon" text="🏛" />
                        <Label styleClass="logo-text" text="MUSEUM DIGITAL" />
                    </children>
                </VBox>

                <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                    <padding><Insets left="15.0" right="15.0" top="20.0" /></padding>
                    <children>
                        <Button onAction="#navigateToDashboard" alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="50.0" styleClass="menu-button" text="⊞ Dashboard" />
                        <Button onAction="#navigateToUsers" alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="50.0" styleClass="menu-button" text="Utilisateurs" />
                        <Button onAction="#navigateToProducts" alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="50.0" styleClass="menu-button" text="Produits" />
                        <Button onAction="#navigateToEvents" alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="50.0" styleClass="menu-button" text="Événements" />
                        <Button onAction="#navigateToReservations" alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="50.0" styleClass="menu-button" text="🎟 Réservation" />
                        <Button onAction="#navigateToSponsors" alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="50.0" styleClass="menu-button-active" text="Sponsors" />
                        <Button onAction="#navigateToOffers" alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="50.0" styleClass="menu-button" text="Gestion des Offres" />
                        <Button onAction="#navigateToDemandes" alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="50.0" styleClass="menu-button" text="Candidatures" />
                        <Button onAction="#navigateToForum" alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="50.0" styleClass="menu-button" text="Forum" />
                    </children>
                </VBox>

                <VBox alignment="CENTER" prefHeight="100.0" spacing="10.0" style="-fx-padding: 15;">
                    <children>
                        <Button onAction="#handleRefreshSidebar" prefWidth="180.0" prefHeight="40.0" styleClass="sidebar-action-button" text="↻ Actualiser" />
                        <Button onAction="#handleLogoutSidebar" prefWidth="180.0" prefHeight="40.0" styleClass="sidebar-action-button" text="🚪 Se Déconnecter" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox fx:id="contentContainer" alignment="TOP_CENTER" maxHeight="Infinity" maxWidth="Infinity" spacing="20.0" style="-fx-padding: 20; -fx-background-color: #e8eef2;">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox>
                            <Label styleClass="section-title" text="Offres de Sponsoring" />
                            <Label styleClass="section-subtitle" text="Gérez les packs et avantages partenaires" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <VBox alignment="CENTER_RIGHT">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Admin" />
                                    <Label style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;" text="Administrator" />
                                </VBox>
                                <Circle fill="#D4AF37" radius="20.0" stroke="WHITE" strokeType="INSIDE" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <FlowPane fx:id="statsContainer" hgap="20.0" vgap="20.0">
                    <children>
                        <VBox minWidth="220.0" prefWidth="250.0" styleClass="stat-card">
                            <children>
                                <Label styleClass="stat-label" text="Total Packs" />
                                <Label fx:id="nbTotalPacks" styleClass="stat-value" text="0" />
                            </children>
                        </VBox>
                        <VBox minWidth="220.0" prefWidth="250.0" styleClass="stat-card">
                            <children>
                                <Label styleClass="stat-label" text="Prix Moyen (DT)" />
                                <Label fx:id="prixMoyenPack" styleClass="stat-value" text="0" />
                            </children>
                        </VBox>
                        <VBox minWidth="220.0" prefWidth="250.0" styleClass="stat-card">
                            <children>
                                <Label styleClass="stat-label" text="Pack le plus élevé" />
                                <Label fx:id="maxPackValue" styleClass="stat-value" text="0" />
                            </children>
                        </VBox>
                    </children>
                </FlowPane>

                <VBox maxWidth="Infinity" spacing="15.0" styleClass="table-container" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="18.0" left="18.0" right="18.0" top="18.0" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Catalogue des Packs" />
                                <ComboBox fx:id="categoryFilter" prefHeight="40.0" prefWidth="220.0" promptText="Toutes les catégories" styleClass="custom-combo" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button onAction="#ouvrirFormulaireAjout" prefHeight="40.0" styleClass="btn-ajouter-museum" text="+ Nouveau Pack" />
                            </children>
                        </HBox>

                        <ScrollPane fx:id="packsScrollPane" fitToWidth="true" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <FlowPane fx:id="packsContainer" alignment="TOP_LEFT" hgap="18.0" style="-fx-padding: 8;" vgap="18.0" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
