<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.museum.controllers.ResetPasswordController">

    <children>
        <SplitPane dividerPositions="0.4" prefHeight="600.0" prefWidth="900.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>


                <!-- Partie droite - Formulaire -->
                <AnchorPane style="-fx-background-color: #F8F5F0;">
                    <children>
                        <VBox alignment="CENTER" spacing="15.0" prefHeight="600.0" prefWidth="540.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <padding>
                                <Insets left="30.0" right="30.0" top="20.0" bottom="20.0" />
                            </padding>
                            <children>
                                <VBox alignment="CENTER" spacing="5.0">
                                    <children>
                                        <Label styleClass="logo-icon-dark" text="🏛" />
                                        <Label styleClass="logo-text-dark" text="MUSEUM DIGITAL" />
                                    </children>
                                </VBox>

                                <!-- Espace flexible en haut -->
                                <Region VBox.vgrow="ALWAYS" />

                                <!-- ÉTAPE 1 : Email -->
                                <VBox fx:id="step1Container" alignment="CENTER" spacing="15.0" maxWidth="380.0"
                                      visible="true" managed="${step1Container.visible}">
                                    <children>
                                        <Label text="🔐 Mot de passe oublié" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                                        <Label text="Entrez votre adresse email. Nous vous enverrons un code de réinitialisation." textFill="#7f8c8d" wrapText="true" textAlignment="CENTER" />

                                        <VBox spacing="5.0" maxWidth="350.0">
                                            <children>
                                                <Label text="Adresse email" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
                                                <TextField fx:id="emailField" prefHeight="40.0" promptText="ex: user@museum.com" styleClass="login-input" />
                                            </children>
                                        </VBox>

                                        <Button onAction="#handleSendResetEmail" prefHeight="40.0" maxWidth="350.0" styleClass="action-button-gold" text="📧 Envoyer le code" />

                                    </children>
                                </VBox>

                                <!-- ÉTAPE 2 : Code -->
                                <VBox fx:id="step2Container" alignment="CENTER" spacing="15.0" maxWidth="380.0"
                                      visible="false" managed="${step2Container.visible}">
                                    <children>
                                        <Label text="🔑 Vérification" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                                        <Label text="Entrez le code à 6 chiffres reçu par email." textFill="#7f8c8d" wrapText="true" textAlignment="CENTER" />

                                        <VBox spacing="5.0" maxWidth="350.0">
                                            <children>
                                                <Label text="Code de réinitialisation" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
                                                <TextField fx:id="codeField" prefHeight="40.0" promptText="123456" styleClass="login-input" />
                                            </children>
                                        </VBox>

                                        <Button onAction="#handleVerifyCode" prefHeight="40.0" maxWidth="350.0" styleClass="action-button-gold" text="✅ Vérifier le code" />

                                        <HBox alignment="CENTER" spacing="5.0">
                                            <Label text="Pas reçu ?" textFill="#666" />
                                            <Hyperlink onAction="#handleResendCode" text="Renvoyer" style="-fx-text-fill: #d4af37; -fx-font-weight: bold;" />
                                        </HBox>

                                        <Hyperlink onAction="#handleBackToLogin" text="← Retour à la connexion" style="-fx-text-fill: #d4af37; -fx-font-weight: bold;" />
                                    </children>
                                </VBox>

                                <!-- ÉTAPE 3 : Nouveau mot de passe -->
                                <VBox fx:id="step3Container" alignment="CENTER" spacing="15.0" maxWidth="380.0"
                                      visible="false" managed="${step3Container.visible}">
                                    <children>
                                        <Label text="🔐 Nouveau mot de passe" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                                        <Label text="Créez votre nouveau mot de passe." textFill="#7f8c8d" />

                                        <VBox spacing="5.0" maxWidth="350.0">
                                            <children>
                                                <Label text="Nouveau mot de passe" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
                                                <PasswordField fx:id="newPasswordField" prefHeight="40.0" promptText="Minimum 6 caractères" styleClass="login-input" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="5.0" maxWidth="350.0">
                                            <children>
                                                <Label text="Confirmer" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
                                                <PasswordField fx:id="confirmPasswordField" prefHeight="40.0" promptText="Confirmez" styleClass="login-input" />
                                            </children>
                                        </VBox>

                                        <Button onAction="#handleResetPassword" prefHeight="40.0" maxWidth="350.0" styleClass="action-button-gold" text="✅ Réinitialiser" />

                                        <Hyperlink onAction="#handleBackToLogin" text="← Retour à la connexion" style="-fx-text-fill: #d4af37; -fx-font-weight: bold;" />
                                    </children>
                                </VBox>

                                <!-- Espace flexible en bas -->
                                <Region VBox.vgrow="ALWAYS" />

                                <!-- Messages -->
                                <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;" wrapText="true" textAlignment="CENTER" visible="false" />
                                <Label fx:id="successLabel" style="-fx-text-fill: #27ae60; -fx-font-size: 12px;" wrapText="true" textAlignment="CENTER" visible="false" />
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
</AnchorPane>