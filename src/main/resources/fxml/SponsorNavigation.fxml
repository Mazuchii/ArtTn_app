<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="850.0" prefWidth="1300.0" style="-fx-background-color: #f4f7f6;" stylesheets="@/css/style.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.museum.controllers.SponsorNavigationController">

    <center>
        <VBox spacing="22.0" style="-fx-padding: 26;">
            <children>
                <!-- HEADER (Identique a EvenementList) -->
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Espace Sponsoring" />
                                <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;" text="Votre sponsorisation a bien ete enregistree. Choisissez votre prochaine action." />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="12.0">
                            <children>
                                <VBox alignment="CENTER_RIGHT">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Ahmed Atrous" />
                                    <Label style="-fx-font-size: 11; -fx-text-fill: #d4af37;" text="Sponsor" />
                                </VBox>
                                <Circle fill="#d4af37" radius="22.0" stroke="WHITE" strokeType="INSIDE" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- CONTENT (Les 3 cartes de choix) -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <HBox alignment="CENTER" spacing="28.0" style="-fx-padding: 60 0 20 0;">
                            <children>
                                <VBox prefWidth="320.0" spacing="18.0" styleClass="sponsor-choice-card" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 18; -fx-border-color: #e5e7eb; -fx-border-radius: 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4); -fx-alignment: center;">
                                    <children>
                                        <Label style="-fx-font-size: 48px; -fx-text-fill: #d4af37;" text="💰" />
                                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Mes Donations" />
                                        <Label style="-fx-text-fill: #7f8c8d; -fx-text-alignment: center; -fx-font-size: 14px;"
                                               text="Consultez vos demandes de sponsoring et suivez leur statut en un coup d'oeil." wrapText="true" />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Button onAction="#navigateToDonations" prefHeight="42.0" styleClass="action-button-gold" text="Consulter mes dons" />
                                    </children>
                                </VBox>

                                <VBox prefWidth="320.0" spacing="18.0" styleClass="sponsor-choice-card" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 18; -fx-border-color: #e5e7eb; -fx-border-radius: 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4); -fx-alignment: center;">
                                    <children>
                                        <Label style="-fx-font-size: 48px; -fx-text-fill: #34495e;" text="📦" />
                                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Les Packs" />
                                        <Label style="-fx-text-fill: #7f8c8d; -fx-text-alignment: center; -fx-font-size: 14px;"
                                               text="Parcourez les offres disponibles et choisissez un nouveau pack a sponsoriser." wrapText="true" />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Button onAction="#navigateToPacks" prefHeight="42.0" style="-fx-background-color: #34495e; -fx-text-fill: white;" styleClass="action-button-gold" text="Voir les offres" />
                                    </children>
                                </VBox>

                                <VBox prefWidth="320.0" spacing="18.0" styleClass="sponsor-choice-card" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 18; -fx-border-color: #e5e7eb; -fx-border-radius: 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4); -fx-alignment: center;">
                                    <children>
                                        <Label style="-fx-font-size: 48px; -fx-text-fill: #e74c3c;" text="🎭" />
                                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Evenements" />
                                        <Label style="-fx-text-fill: #7f8c8d; -fx-text-alignment: center; -fx-font-size: 14px;"
                                               text="Retournez a la liste des evenements pour decouvrir d'autres opportunites." wrapText="true" />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Button onAction="#navigateToEvents" prefHeight="42.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" styleClass="action-button-gold" text="Explorer" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </center>
</BorderPane>
