<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="700.0" prefWidth="1200.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.museum.controllers.LoginController">
    <children>
        <SplitPane dividerPositions="0.4" orientation="HORIZONTAL" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" style="-fx-box-border: transparent; -fx-background-color: transparent;">
            <items>

                <!-- PARTIE GAUCHE (40%) - Image centrée -->
                <StackPane style="-fx-background-color: #1a1a2e;">
                    <children>
                        <ImageView fx:id="loginImageView" fitHeight="500.0" fitWidth="400.0" pickOnBounds="true" preserveRatio="true" StackPane.alignment="CENTER">
                            <image>
                                <Image url="@../images/login_image.png" />
                            </image>
                        </ImageView>
                    </children>
                </StackPane>

                <!-- PARTIE DROITE (60%) - Formulaire -->
                <AnchorPane style="-fx-background-color: white;">
                    <children>
                        <VBox alignment="CENTER" spacing="25.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <padding>
                                <Insets left="50.0" right="50.0" />
                            </padding>
                            <children>
                                <Region VBox.vgrow="ALWAYS" />

                                <!-- Sélecteur de langue -->
                                <HBox alignment="CENTER_RIGHT" maxWidth="380.0">
                                    <ComboBox fx:id="languageCombo"
                                              style="-fx-background-color: #f8f8f8; -fx-border-color: #D4AF37;
                                                     -fx-border-radius: 8; -fx-background-radius: 8;
                                                     -fx-font-size: 12px; -fx-cursor: hand;"
                                              prefWidth="145" />
                                </HBox>

                                <Label fx:id="loginTitleLabel" text="Connexion" textFill="#2c3e50"
                                       style="-fx-font-size: 32px; -fx-font-weight: bold;" />

                                <VBox maxWidth="380.0" spacing="8.0">
                                    <children>
                                        <Label fx:id="emailLabel" text="Email/Username" textFill="#555555"
                                               style="-fx-font-weight: bold;" />
                                        <TextField fx:id="usernameField" prefHeight="50.0"
                                                   promptText="Entrez votre email ou nom d'utilisateur"
                                                   style="-fx-background-radius: 10; -fx-border-radius: 10;
                                                          -fx-border-color: #ddd; -fx-border-width: 1.5; -fx-padding: 0 15;" />
                                    </children>
                                </VBox>

                                <VBox maxWidth="380.0" spacing="8.0">
                                    <children>
                                        <Label fx:id="passwordLabel" text="Password" textFill="#555555"
                                               style="-fx-font-weight: bold;" />
                                        <StackPane>
                                            <PasswordField fx:id="passwordField" prefHeight="50.0"
                                                           promptText="Entrez votre mot de passe"
                                                           style="-fx-background-radius: 10; -fx-border-radius: 10;
                                                                  -fx-border-color: #ddd; -fx-border-width: 1.5; -fx-padding: 0 45 0 15;" />
                                            <TextField fx:id="passwordVisible" prefHeight="50.0"
                                                       promptText="Entrez votre mot de passe"
                                                       visible="false" managed="false"
                                                       style="-fx-background-radius: 10; -fx-border-radius: 10;
                                                              -fx-border-color: #ddd; -fx-border-width: 1.5; -fx-padding: 0 45 0 15;" />
                                            <Button fx:id="togglePasswordBtn" text="👁" onAction="#handleTogglePassword"
                                                    style="-fx-background-color: transparent; -fx-cursor: hand;
                                                           -fx-font-size: 16px; -fx-padding: 0 10 0 0;"
                                                    StackPane.alignment="CENTER_RIGHT" />
                                        </StackPane>
                                    </children>
                                </VBox>

                                <HBox alignment="CENTER_LEFT" maxWidth="380.0">
                                    <children>
                                        <CheckBox fx:id="rememberMeCheckbox" text="Remember Me" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Hyperlink fx:id="forgotLink" onAction="#handleForgotPassword"
                                                   text="Forgot password?" style="-fx-text-fill: #d4af37;" />
                                    </children>
                                </HBox>

                                <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c;" visible="false" />

                                <Button fx:id="loginButton" onAction="#handleLogin" prefHeight="50.0" maxWidth="380.0"
                                        style="-fx-background-color: #d4af37; -fx-background-radius: 10;
                                               -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 14px;"
                                        text="Login" />

                                <Button fx:id="googleLoginButton" onAction="#handleGoogleLogin"
                                        prefHeight="50.0" maxWidth="380.0"
                                        style="-fx-background-color: white; -fx-background-radius: 10;
                                               -fx-border-color: #ddd; -fx-border-radius: 10;
                                               -fx-text-fill: #555; -fx-font-weight: bold;"
                                        text="🅶 Se connecter avec Google">
                                    <VBox.margin><Insets top="10.0" /></VBox.margin>
                                </Button>

                                <HBox alignment="CENTER" spacing="5.0">
                                    <children>
                                        <Label fx:id="noAccountLabel" text="Don't have an account?" textFill="#666666" />
                                        <Hyperlink fx:id="signupLink" onAction="#handleSignup"
                                                   text="Sign up now!" style="-fx-text-fill: #d4af37; -fx-font-weight: bold;" />
                                    </children>
                                </HBox>

                                <Region VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>

            </items>
        </SplitPane>
    </children>
</AnchorPane>
