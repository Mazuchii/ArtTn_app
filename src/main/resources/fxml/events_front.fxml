<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane style="-fx-background-color: #f4f7f6;"
            stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.museum.controllers.EventFrontController">

    <BorderPane AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <top>
            <HBox alignment="CENTER_LEFT" spacing="15.0"
                  style="-fx-background-color: white; -fx-padding: 12 25;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                <Label text="📅 Catalogue des Événements"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchField"
                           promptText="🔍 Rechercher un événement..."
                           prefWidth="250" prefHeight="35"
                           style="-fx-background-radius: 20; -fx-border-radius: 20;
                                  -fx-border-color: #ddd; -fx-padding: 5 15;" />
                <ComboBox fx:id="categoryFilter" prefWidth="150" prefHeight="35" />
                <ComboBox fx:id="sortCombo" prefWidth="170" prefHeight="35" />
                <Button onAction="#handleMyReservations" text="📋 Mes Réservations"
                        prefHeight="35"
                        style="-fx-background-color: #D4AF37; -fx-text-fill: #1a1a2e;
                               -fx-font-weight: bold; -fx-background-radius: 8;
                               -fx-padding: 0 15; -fx-cursor: hand;" />
                <Button onAction="#handleMyDonations" text="Mes Donations"
                        prefHeight="35"
                        style="-fx-background-color: #1a1a2e; -fx-text-fill: #D4AF37;
                               -fx-font-weight: bold; -fx-background-radius: 8;
                               -fx-padding: 0 15; -fx-cursor: hand;" />
            </HBox>
        </top>

        <center>
            <ScrollPane fitToWidth="true" fitToHeight="true"
                        style="-fx-background: #f4f7f6; -fx-background-color: #f4f7f6;
                               -fx-border-color: transparent;">
                <VBox fx:id="eventsContainer" spacing="20"
                      style="-fx-padding: 25; -fx-background-color: #f4f7f6;" />
            </ScrollPane>
        </center>

        <bottom>
            <HBox alignment="CENTER" spacing="10"
                  style="-fx-padding: 12; -fx-background-color: #1a1a2e;">
                <Label text="© 2025 Museum Digital — Tous droits réservés"
                       style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;" />
            </HBox>
        </bottom>
    </BorderPane>

    <Button fx:id="chatbotButton" text="🤖"
            onAction="#toggleChatbot"
            style="-fx-background-color: #D4AF37; -fx-text-fill: #1a1a2e;
                   -fx-font-size: 20px; -fx-font-weight: bold;
                   -fx-background-radius: 30; -fx-padding: 15;
                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 5);
                   -fx-cursor: hand;"
            AnchorPane.bottomAnchor="20" AnchorPane.rightAnchor="20" />

</AnchorPane>
