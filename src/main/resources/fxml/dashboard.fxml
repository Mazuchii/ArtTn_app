<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #e8eef2;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.museum.controllers.DashboardController">

    <left>
        <VBox prefWidth="260.0" styleClass="sidebar">
            <children>
                <VBox alignment="CENTER" prefHeight="120.0" spacing="10.0">
                    <children>
                        <Label styleClass="logo-icon" text="🏛" />
                        <Label styleClass="logo-text" text="ART.TN" />
                    </children>
                </VBox>

                <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets left="15.0" right="15.0" top="20.0" />
                    </padding>
                    <children>
                        <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" prefHeight="50.0" styleClass="menu-button" text="⊞ Dashboard" />
                        <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" prefHeight="50.0" styleClass="menu-button-active" text="👥 Utilisateurs" />
                        <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" prefHeight="50.0" styleClass="menu-button" text="📦 Produits" />
                        <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" prefHeight="50.0" styleClass="menu-button" text="📅 Événements" />
                        <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" prefHeight="50.0" styleClass="menu-button" text="🤝 Sponsors" />
                        <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" prefHeight="50.0" styleClass="menu-button" text="👔 Employés" />
                        <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" prefHeight="50.0" styleClass="menu-button" text="💬 Forum" />
                    </children>
                </VBox>

                <VBox alignment="CENTER" prefHeight="100.0" style="-fx-background-color: #2D3436;">
                    <children>
                        <Button onAction="#handleLogout" prefWidth="180.0" prefHeight="40.0" styleClass="logout-button" text=" Se Déconnecter" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0" style="-fx-padding: 20; -fx-background-color: #e8eef2;" VBox.vgrow="ALWAYS">
            <children>
                <!-- Header avec bienvenue -->
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <VBox alignment="CENTER_RIGHT">
                                    <Label fx:id="welcomeLabel" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Admin" />
                                    <Label style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;" text="Administrator" />
                                </VBox>
                                <Circle fill="#D4AF37" radius="20.0" stroke="WHITE" strokeType="INSIDE" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- STATS CARDS - 4 cartes -->
                <HBox spacing="20.0">
                    <children>
                        <!-- Carte Total Utilisateurs -->
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="stat-label" text="📊 Total Utilisateurs" />
                                <Label fx:id="statsTotalUsers" styleClass="stat-value" text="0" />
                            </children>
                        </VBox>

                        <!-- Carte Utilisateurs Actifs -->
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="stat-label" text="✅ Utilisateurs Actifs" />
                                <Label fx:id="statsActiveUsers" styleClass="stat-value" text="0" />
                            </children>
                        </VBox>

                        <!-- Carte Administrateurs -->
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="stat-label" text="👑 Administrateurs" />
                                <Label fx:id="statsAdmins" styleClass="stat-value" text="0" />
                            </children>
                        </VBox>

                        <!-- Carte Comptes Désactivés (cliquable) -->
                        <VBox fx:id="inactiveCard" styleClass="stat-card-inactive" HBox.hgrow="ALWAYS" onMouseClicked="#handleShowInactiveUsers">
                            <children>
                                <Label styleClass="stat-label-inactive" text="🚫 Comptes Désactivés" />
                                <Label fx:id="statsInactiveUsers" styleClass="stat-value-inactive" text="0" />
                                <Label styleClass="stat-click-hint" text="Cliquez pour voir la liste ➔" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- TITRE SECTION -->
                <Label text="👥 Gestion des Utilisateurs" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

                <!-- TABLE SECTION -->
                <VBox spacing="15.0" styleClass="table-container" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
                    <children>
                        <!-- Barre de recherche et filtres -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <TextField fx:id="searchField" prefHeight="40.0" prefWidth="600.0" promptText="🔍 Rechercher par nom, email ou username..." styleClass="search-bar-integrated" />
                                <ComboBox fx:id="roleFilterCombo" prefHeight="40.0" prefWidth="200.0" promptText="📌 Filtrer par rôle" styleClass="custom-combo" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button onAction="#handleAddUser" prefHeight="45.0" prefWidth="220.0" styleClass="action-button-gold" text="➕ Ajouter un administrateur" />
                            </children>
                        </HBox>

                        <!-- TABLEAU -->
                        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" styleClass="enhanced-table">
                            <columns>
                                <TableColumn fx:id="idColumn" prefWidth="60.0" text="🆔 ID" />
                                <TableColumn fx:id="usernameColumn" prefWidth="180.0" text="👤 Nom d'utilisateur" />
                                <TableColumn fx:id="emailColumn" prefWidth="280.0" text="📧 Adresse email" />
                                <TableColumn fx:id="fullNameColumn" prefWidth="220.0" text="📛 Nom complet" />
                                <TableColumn fx:id="roleColumn" prefWidth="120.0" text="🎭 Rôle" />
                                <TableColumn fx:id="activeColumn" prefWidth="120.0" text="🟢 Statut" />
                            </columns>
                            <placeholder>
                                <Label text="📭 Aucun utilisateur trouvé" style="-fx-text-fill: #999; -fx-font-size: 14px;" />
                            </placeholder>
                        </TableView>

                        <!-- Statistiques du tableau -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label fx:id="tableStatsLabel" text="Affichage de 0 utilisateur" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" />
                                <Region HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <!-- Boutons d'action -->
                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                            <children>
                                <Button onAction="#handleToggleUserStatus" prefHeight="45.0" prefWidth="170.0" styleClass="action-button-gold" text="🔄 Activer / Désactiver" />
                                <Button onAction="#handleEditUser" prefHeight="45.0" prefWidth="130.0" styleClass="action-button-gold" text="✏️ Modifier" />
                                <Button onAction="#handleDeleteUser" prefHeight="45.0" prefWidth="130.0" styleClass="action-button-gold" text="🗑️ Supprimer" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>