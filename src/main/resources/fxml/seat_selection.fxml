<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane prefHeight="750.0" prefWidth="950.0"
            stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.museum.controllers.SeatSelectionController">

    <!-- HEADER -->
    <top>
        <VBox spacing="5.0" style="-fx-background-color: #1a1a2e; -fx-padding: 15 25;">
            <Label text="🏛️ MUSEUM DIGITAL"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Label fx:id="eventTitleLabel"
                   style="-fx-font-size: 14px; -fx-text-fill: #D4AF37;" />
        </VBox>
    </top>

    <!-- CONTENU -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #f4f7f6; -fx-background-color: #f4f7f6;">
            <VBox spacing="20.0" style="-fx-padding: 25;">

                <!-- Infos événement -->
                <HBox spacing="20.0"
                      style="-fx-background-color: white; -fx-padding: 15;
                             -fx-background-radius: 10;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.08),8,0,0,3);">
                    <ImageView fx:id="eventImageView"
                               fitHeight="100" fitWidth="120" preserveRatio="true" />
                    <VBox spacing="6.0">
                        <Label fx:id="eventTitle"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <Label fx:id="eventLocation"
                               style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" />
                        <Label fx:id="eventDateTime"
                               style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" />
                        <Label fx:id="eventPricePerTicket"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #D4AF37;" />
                        <Label fx:id="availableSeatsLabel"
                               style="-fx-font-size: 13px; -fx-text-fill: #27ae60; -fx-font-weight: bold;" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="✕ Fermer" onAction="#handleClose"
                            style="-fx-background-color: transparent; -fx-text-fill: #e74c3c;
                                   -fx-cursor: hand; -fx-underline: true;" />
                </HBox>

                <!-- Plan de la salle -->
                <VBox spacing="15.0"
                      style="-fx-background-color: white; -fx-border-color: #eee;
                             -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.08),8,0,0,3);">
                    <Label text="🎭 Scène / Écran"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;
                                  -fx-text-fill: #2c3e50; -fx-alignment: CENTER;"
                           maxWidth="1.7976931348623157E308" />
                    <Separator />
                    <GridPane fx:id="seatsGrid" hgap="8.0" vgap="8.0"
                              alignment="CENTER" />
                </VBox>

                <!-- Légende -->
                <HBox spacing="25.0" alignment="CENTER">
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Rectangle width="18" height="18" fill="#D4AF37" arcWidth="4" arcHeight="4"/>
                        <Label text="Standard" style="-fx-font-size: 12px;" />
                    </HBox>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Rectangle width="18" height="18" fill="#4CAF50" arcWidth="4" arcHeight="4"/>
                        <Label text="VIP (+10 DT)" style="-fx-font-size: 12px;" />
                    </HBox>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Rectangle width="18" height="18" fill="#2196F3" arcWidth="4" arcHeight="4"/>
                        <Label text="Sélectionné" style="-fx-font-size: 12px;" />
                    </HBox>
                </HBox>

                <!-- Récapitulatif sièges -->
                <VBox spacing="5.0"
                      style="-fx-background-color: white; -fx-padding: 12;
                             -fx-background-radius: 8; -fx-border-color: #eee;
                             -fx-border-radius: 8;">
                    <Label fx:id="selectedSeatsLabel" text="Aucun siège sélectionné"
                           style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"
                           wrapText="true" />
                    <Label fx:id="totalPriceLabel" text="Total : 0,00 DT"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #D4AF37;" />
                </VBox>

                <!-- Informations client - supprimé -->

                <!-- Code promo -->
                <VBox spacing="8.0"
                      style="-fx-background-color: white; -fx-padding: 15;
                             -fx-background-radius: 10; -fx-border-color: #eee;
                             -fx-border-radius: 10;">
                    <Label text="🎟️ Code promo"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <TextField fx:id="promoCodeField"
                               promptText="Entrez votre code (ex: ArtTn)" prefHeight="35"
                               style="-fx-background-radius: 6; -fx-border-color: #ddd;
                                      -fx-border-radius: 6;" />
                    <Label fx:id="discountLabel" text=""
                           style="-fx-font-size: 12px; -fx-text-fill: #27ae60; -fx-font-weight: bold;" />
                </VBox>

                <!-- Boutons -->
                <HBox spacing="15.0" alignment="CENTER_RIGHT">
                    <Button text="✅ Valider la Réservation"
                            onAction="#handleConfirm"
                            prefHeight="42" prefWidth="220"
                            style="-fx-background-color: #D4AF37; -fx-text-fill: #1a1a2e;
                                   -fx-font-weight: bold; -fx-font-size: 13px;
                                   -fx-background-radius: 25; -fx-cursor: hand;" />
                    <Button text="❌ Annuler"
                            onAction="#handleClose"
                            prefHeight="42" prefWidth="120"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 25;
                                   -fx-cursor: hand;" />
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
