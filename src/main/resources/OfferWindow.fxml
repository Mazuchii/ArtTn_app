<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:id="mainContainer" prefHeight="800.0" prefWidth="1200.0"
            style="-fx-background-color: #FDFBF8;"
            stylesheets="@./css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.cnx.controllers.OfferJobController">

    <left>
        <VBox prefWidth="250.0" styleClass="sidebar" spacing="5.0">
            <children>
                <VBox alignment="CENTER" prefHeight="150.0" spacing="10.0">
                    <children>
                        <Label text="🏛" style="-fx-font-size: 45; -fx-text-fill: #CC9933;" />
                        <Label text="MUSEUM DIGITAL" styleClass="logo-text" />
                    </children>
                </VBox>

                <Button maxWidth="Infinity" styleClass="menu-button" text="⊞ Dashboard" />
                <Button maxWidth="Infinity" styleClass="menu-button" text="Utilisateurs" />
                <Button maxWidth="Infinity" styleClass="menu-button" text="Produits" />
                <Button maxWidth="Infinity" styleClass="menu-button-active" text="Gestion des Offres" />
                <Button onAction="#naviguerVersDemandes" maxWidth="Infinity" styleClass="menu-button" text="Candidatures" />
                <Button maxWidth="Infinity" styleClass="menu-button" text="Sponsors" />
                <Button maxWidth="Infinity" styleClass="menu-button" text="Evenements" />
                <Button maxWidth="Infinity" styleClass="menu-button" text="Forum" />

                <Region VBox.vgrow="ALWAYS" />

                <Button onAction="#handleNavigate" maxWidth="Infinity" styleClass="logout-button-museum" text="Se Déconnecter">
                    <VBox.margin><Insets bottom="25.0" left="20.0" right="20.0" /></VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0" style="-fx-padding: 30;">
            <children>
                <HBox alignment="CENTER_RIGHT" prefHeight="50.0">
                    <children>
                        <VBox alignment="CENTER_RIGHT">
                            <Label text="Bienvenue, Administrator!" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                            <Label text="Administrator" style="-fx-text-fill: #999; -fx-font-size: 11;" />
                        </VBox>
                        <Region prefWidth="15" />
                        <StackPane style="-fx-background-color: #CC9933; -fx-background-radius: 50;" prefWidth="40" prefHeight="40" />
                    </children>
                </HBox>

                <HBox spacing="20.0">
                    <children>
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <Label text="Total Offres" styleClass="stat-label" />
                            <Label text="6" styleClass="stat-value" />
                        </VBox>
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <Label text="Offres Actives" styleClass="stat-label" />
                            <Label text="6" styleClass="stat-value" />
                        </VBox>
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <Label text="Recruteurs" styleClass="stat-label" />
                            <Label text="2" styleClass="stat-value" />
                        </VBox>
                    </children>
                </HBox>

                <VBox styleClass="table-container-white" VBox.vgrow="ALWAYS" spacing="15">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <TextField fx:id="tfRecherche" onKeyReleased="#handleRecherche" prefWidth="350.0"
                                           promptText="🔍 Recherche..." styleClass="search-bar-museum" />
                                <Region HBox.hgrow="ALWAYS" />

                                <Button onAction="#handleStatistiques" styleClass="btn-action-outline" text="📊 Statistiques" />

                                <Button onAction="#showAddFormPopup" styleClass="btn-ajouter-museum" text="+ Ajouter offre" />
                            </children>
                        </HBox>

                        <TableView fx:id="tableOffers" prefHeight="400.0" styleClass="museum-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTitre" prefWidth="150.0" text="Titre" />
                                <TableColumn fx:id="colDesc" prefWidth="300.0" text="Description" />
                                <TableColumn fx:id="colSalaire" prefWidth="100.0" text="Salaire (DT)" />
                                <TableColumn fx:id="colAction" prefWidth="120.0" text="Action" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button onAction="#switchToFront" styleClass="btn-action-outline" text="Mode Artiste" />
                                <Button onAction="#handleTriSalaire" styleClass="btn-action-yellow" text="Trier Salaire" />
                                <Button onAction="#handleModifier" styleClass="btn-action-yellow" text="Modifier" />
                                <Button onAction="#handleSupprimer" styleClass="btn-action-yellow" text="Supprimer" />
                            </children>
                        </HBox>
                    </children>
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>