<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:id="mainContainer" prefHeight="800.0" prefWidth="1200.0"
            style="-fx-background-color: #F8F5F0;"
            stylesheets="@./css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.cnx.controllers.JobFrontController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0"
              style="-fx-background-color: #1a1a2e; -fx-padding: 15 30;">
            <children>

                <Label text="ART.TN DIGITAL"
                       textFill="#d4af37"
                       style="-fx-font-weight: bold; -fx-font-size: 20px;" />

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="25.0">
                    <children>
                        <Hyperlink styleClass="nav-link-active" text="Offres d'Emploi" />
                        <Hyperlink styleClass="nav-link" text="Galerie" />
                        <Hyperlink styleClass="nav-link" text="Expositions" />
                    </children>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <TextField fx:id="tfRecherche"
                           onKeyReleased="#handleRecherche"
                           prefWidth="250.0"
                           promptText="🔍 Rechercher..."
                           styleClass="search-bar-light" />

                <Button text="Tableau de Bord"
                        onAction="#switchToBack"
                        style="-fx-background-color: transparent; -fx-border-color: #d4af37; -fx-text-fill: #d4af37; -fx-border-radius: 5; -fx-cursor: hand;" />

            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <content>
                <VBox spacing="30.0" style="-fx-padding: 0 0 30 0;">
                    <children>

                        <StackPane prefHeight="350.0">
                            <children>
                                <ImageView fitHeight="350.0"
                                           fitWidth="1200.0"
                                           preserveRatio="false">
                                    <image>
                                        <Image url="@./images/art_banner.jpg" />
                                    </image>
                                </ImageView>

                                <VBox alignment="CENTER"
                                      spacing="15.0"
                                      style="-fx-background-color: rgba(0,0,0,0.5);">
                                    <children>
                                        <Label text="L'Art de Recruter" textFill="#d4af37">
                                            <font>
                                                <Font name="System Bold Italic" size="50.0" />
                                            </font>
                                        </Label>

                                        <Label text="Trouvez les opportunités les plus prestigieuses du marché"
                                               textFill="WHITE">
                                            <font>
                                                <Font size="18.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>

                        <VBox spacing="10.0" style="-fx-padding: 0 40;">
                            <children>
                                <HBox alignment="BOTTOM_LEFT">
                                    <children>
                                        <Label text="Opportunités à la une" textFill="#2c3e50">
                                            <font>
                                                <Font name="System Bold" size="26.0" />
                                            </font>
                                        </Label>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label text="Filtres: Récents" textFill="#8c7e5e" style="-fx-font-style: italic;" />
                                    </children>
                                </HBox>
                                <Separator />
                            </children>
                        </VBox>

                        <FlowPane fx:id="flowPane"
                                  hgap="25.0"
                                  vgap="25.0"
                                  prefWrapLength="1120.0"
                                  style="-fx-padding: 0 40;" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" prefHeight="60.0" style="-fx-background-color: #1a1a2e;">
            <children>
                <Label text="© 2026 Art.tn Digital - La plateforme d'excellence pour les artistes" textFill="#7f8c8d" />
            </children>
        </HBox>
    </bottom>

</BorderPane>