<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.museum.controllers.LoginController"
           style="-fx-background-color: #1a1a2e;"
           maxWidth="Infinity" maxHeight="Infinity">

    <VBox alignment="CENTER" spacing="20" maxWidth="400"
          style="-fx-background-color: #1a1a2e;">
        <padding><Insets top="50" right="50" bottom="50" left="50"/></padding>

        <!-- Logo -->
        <Label text="🏛️" style="-fx-font-size: 50px;" />
        <Label text="MUSEUM DIGITAL"
               style="-fx-font-size: 18px; -fx-font-weight: bold;
                      -fx-text-fill: #D4AF37;" />
        <Label text="Connexion"
               style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />

        <VBox spacing="10" maxWidth="300">
            <!-- Email -->
            <Label text="Email" style="-fx-text-fill: white; -fx-font-size: 12px;" />
            <TextField fx:id="emailField"
                       promptText="Entrez votre email"
                       prefHeight="40"
                       style="-fx-background-radius: 8; -fx-font-size: 13px;" />

            <!-- Mot de passe -->
            <Label text="Mot de passe"
                   style="-fx-text-fill: white; -fx-font-size: 12px;" />
            <PasswordField fx:id="passwordField"
                           promptText="Entrez votre mot de passe"
                           prefHeight="40"
                           style="-fx-background-radius: 8; -fx-font-size: 13px;" />

            <!-- Message erreur -->
            <Label fx:id="errorLabel" text=""
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"
                   wrapText="true" />

            <!-- Bouton connexion -->
            <Button text="🔐 Se Connecter"
                    onAction="#handleLogin"
                    prefHeight="45" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color: #D4AF37; -fx-text-fill: #1a1a2e;
                           -fx-font-weight: bold; -fx-font-size: 14px;
                           -fx-background-radius: 8; -fx-cursor: hand;" />
        </VBox>

        <!-- Comptes de test -->
        <VBox alignment="CENTER" spacing="3">
            <Label text="── Comptes de test ──"
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 10px;" />
            <Label text="Admin : admin@museum.tn / admin123"
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 10px;" />
            <Label text="User : user@museum.tn / user123"
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 10px;" />
        </VBox>
    </VBox>

</StackPane>