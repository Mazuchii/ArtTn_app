<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: #f4f7f6;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.museum.controllers.MyReservationsController">

    <top>
        <VBox spacing="10.0" style="-fx-background-color: #1a1a2e; -fx-padding: 15 25;">
            <Label text="🏛️ MUSEUM DIGITAL"
                   textFill="white"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;" />
            <Label text="Mes réservations"
                   textFill="white"
                   style="-fx-font-size: 16px;" />
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    style="-fx-background: #f4f7f6; -fx-background-color: #f4f7f6;
                           -fx-border-color: transparent;">
            <VBox spacing="20.0" style="-fx-padding: 25;">
                <TableView fx:id="reservationsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="eventColumn" prefWidth="200" text="Événement" />
                        <TableColumn fx:id="dateColumn" prefWidth="150" text="Date réservation" />
                        <TableColumn fx:id="ticketsColumn" prefWidth="80" text="Billets" />
                        <TableColumn fx:id="totalColumn" prefWidth="100" text="Total" />
                        <TableColumn fx:id="statusColumn" prefWidth="120" text="Statut" />
                        <TableColumn fx:id="seatsColumn" prefWidth="200" text="Sièges" />
                        <TableColumn fx:id="calendarColumn" prefWidth="100" text="Calendrier" />
                    </columns>
                </TableView>
                <Button onAction="#handleBack" text="← Retour au catalogue"
                        style="-fx-background-color: #D4AF37; -fx-text-fill: #1a1a2e;
                               -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 20;" />
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>