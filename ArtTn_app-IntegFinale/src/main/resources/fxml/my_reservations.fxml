<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: #F8F5F0;"
            stylesheets="@../css/front.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.museum.controllers.MyReservationsController">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="front-header">
                <Label text="🏛️ MUSEUM DIGITAL" styleClass="front-header-logo" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="userWelcomeLabel" text="Bienvenue"
                       style="-fx-text-fill: #D4AF37; -fx-font-weight: bold; -fx-font-size: 13px;" />
                <Button onAction="#handleBackToEvents" text="📅 Événements"
                        styleClass="btn-front-ghost" />
                <Button onAction="#handleLogout" text="🔓 Déconnexion"
                        style="-fx-background-color: transparent; -fx-text-fill: #ff6b6b;
                               -fx-font-weight: bold; -fx-cursor: hand;" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="front-subheader">
                <Label text="📋 Mes Réservations" styleClass="front-page-title" />
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="front-scroll">
            <VBox spacing="20.0" style="-fx-padding: 25;">
                <TableView fx:id="reservationsTable" VBox.vgrow="ALWAYS"
                           styleClass="front-table">
                    <columns>
                        <TableColumn fx:id="eventColumn"    prefWidth="200" text="Événement" />
                        <TableColumn fx:id="dateColumn"     prefWidth="150" text="Date événement" />
                        <TableColumn fx:id="ticketsColumn"  prefWidth="80"  text="Billets" />
                        <TableColumn fx:id="totalColumn"    prefWidth="100" text="Total" />
                        <TableColumn fx:id="statusColumn"   prefWidth="120" text="Statut" />
                        <TableColumn fx:id="seatsColumn"    prefWidth="200" text="Sièges" />
                        <TableColumn fx:id="calendarColumn" prefWidth="100" text="Calendrier" />
                    </columns>
                </TableView>
                <Button onAction="#handleBack" text="← Retour au catalogue"
                        styleClass="btn-front-primary" />
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
