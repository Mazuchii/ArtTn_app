<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:id="mainContainer" prefHeight="800.0" prefWidth="1200.0"
            style="-fx-background-color: #FDFBF8;"
            stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.museum.controllers.DemandeJobController">

    <left>
        <VBox prefWidth="250.0" styleClass="sidebar" spacing="5.0">
            <children>
                <VBox alignment="CENTER" prefHeight="150.0" spacing="10.0">
                    <children>
                        <Label text="🏛" style="-fx-font-size: 45; -fx-text-fill: #CC9933;" />
                        <Label text="MUSEUM DIGITAL" styleClass="logo-text" />
                    </children>
                </VBox>

                <Button maxWidth="Infinity" styleClass="menu-button" text="⊞ Dashboard" />
                <Button maxWidth="Infinity" styleClass="menu-button" text="Utilisateurs" />
                <Button maxWidth="Infinity" styleClass="menu-button" text="Produits" />
                <Button onAction="#naviguerVersOffres" maxWidth="Infinity" styleClass="menu-button" text="Gestion des Offres" />
                <Button maxWidth="Infinity" styleClass="menu-button-active" text="✉ Candidatures" />

                <Button maxWidth="Infinity" styleClass="menu-button" text="Sponsors" />
                <Button maxWidth="Infinity" styleClass="menu-button" text="Forum" />

                <Region VBox.vgrow="ALWAYS" />


                <Button onAction="#handleNavigate" maxWidth="Infinity" styleClass="logout-button-museum" text="Se Déconnecter">
                    <VBox.margin><Insets bottom="25.0" left="20.0" right="20.0" /></VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0" style="-fx-padding: 30;">
            <children>
                <HBox alignment="CENTER_RIGHT" prefHeight="50.0">
                    <children>
                        <Label text="Gestion des Candidatures" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #343a40;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <VBox alignment="CENTER_RIGHT">
                            <Label text="Bienvenue, Administrator!" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                            <Label text="Admin" style="-fx-text-fill: #999; -fx-font-size: 11;" />
                        </VBox>
                        <Region prefWidth="15" />
                        <StackPane prefHeight="40" prefWidth="40" style="-fx-background-color: #CC9933; -fx-background-radius: 50;" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 15;" styleClass="table-container-white">
                    <children>
                        <TextField fx:id="tfRecherche" onKeyReleased="#handleRecherche" prefWidth="400.0" promptText="🔍 Rechercher un candidat ou un statut..." styleClass="search-bar-museum" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleExportExcel" styleClass="btn-excel-meet" text="Excel 📥" />
                        <Button onAction="#afficherStatsCandidatures" styleClass="btn-action-yellow" text="📊 Statistiques" />
                        <Button onAction="#showAddDemandePopup" styleClass="btn-ajouter-museum" text="+ Ajouter une Demande" />
                    </children>
                </HBox>

                <VBox spacing="15" styleClass="table-container-white" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
                    <children>
                        <TableView fx:id="tableDemandes" prefHeight="400.0" styleClass="museum-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colCandidat" prefWidth="220.0" text="Profil candidat" />
                                <TableColumn fx:id="colOffre" prefWidth="260.0" text="Offre liée" />
                                <TableColumn fx:id="colStatus" prefWidth="150.0" text="Statut" />
                                <TableColumn fx:id="colAction" prefWidth="300.0" text="Documents / Meet / Score" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 5 0 0 0;">
                            <children>
                                <Label style="-fx-text-fill: #777; -fx-font-style: italic;" text="Actions sur la sélection :" />
                                <Region prefWidth="10" />
                                <Button onAction="#handleAccepter" styleClass="btn-action-yellow" text="✅ Accepter" />
                                <Button onAction="#handleRefuser" styleClass="btn-action-outline" text="❌ Refuser" />
                                <Button onAction="#handleModifier" styleClass="btn-action-yellow" text="📝 Modifier" />
                                <Button onAction="#handleSupprimer" styleClass="btn-action-outline" text="🗑 Supprimer" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>

