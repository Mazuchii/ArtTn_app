<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.museum.controllers.GoogleSetPasswordController">

    <children>
        <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #F8F5F0;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets left="40.0" right="40.0" top="30.0" bottom="30.0" />
            </padding>
            <children>
                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label text="🏛️" style="-fx-font-size: 40px;" />
                        <Label text="MUSEUM DIGITAL" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #2c3e50;" />
                    </children>
                </VBox>

                <Label text="🔐 Choisir votre mot de passe" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <Label text="Votre compte a été créé avec Google. Choisissez un mot de passe pour pouvoir vous connecter normalement." textFill="#7f8c8d" wrapText="true" textAlignment="CENTER" />

                <VBox spacing="15.0" maxWidth="380.0">
                    <children>
                        <VBox spacing="5.0">
                            <Label text="Nom d'utilisateur" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
                            <TextField fx:id="usernameField" prefHeight="40.0" editable="false" styleClass="login-input" />
                        </VBox>

                        <VBox spacing="5.0">
                            <Label text="Email" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
                            <TextField fx:id="emailField" prefHeight="40.0" editable="false" styleClass="login-input" />
                        </VBox>

                        <VBox spacing="5.0">
                            <Label text="Nom complet" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
                            <TextField fx:id="fullNameField" prefHeight="40.0" editable="false" styleClass="login-input" />
                        </VBox>

                        <Separator />

                        <VBox spacing="5.0">
                            <Label text="Choisir un mot de passe" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
                            <PasswordField fx:id="passwordField" prefHeight="40.0" promptText="Minimum 6 caractères" styleClass="login-input" />
                        </VBox>

                        <VBox spacing="5.0">
                            <Label text="Confirmer le mot de passe" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
                            <PasswordField fx:id="confirmPasswordField" prefHeight="40.0" promptText="Confirmez" styleClass="login-input" />
                        </VBox>
                    </children>
                </VBox>

                <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;" wrapText="true" textAlignment="CENTER" visible="false" />

                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button onAction="#handleSkip" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: transparent; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-text-fill: #666;" text="Ignorer" />
                        <Button onAction="#handleSetPassword" prefHeight="40.0" prefWidth="200.0" styleClass="action-button-gold" text="✅ Créer mon mot de passe" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
