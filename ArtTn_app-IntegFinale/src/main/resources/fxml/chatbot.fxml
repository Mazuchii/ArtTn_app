<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefWidth="420.0" prefHeight="550.0" style="-fx-background-color: #2c3e50; -fx-background-radius: 15; -fx-border-radius: 15;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.museum.controllers.ChatbotController">

    <!-- En-tête -->
    <VBox AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #1a1a2e; -fx-padding: 12 15; -fx-background-radius: 15 15 0 0;">
            <Label text="🎤 Assistant Museum Digital" textFill="white" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="✖" onAction="#closeChat" style="-fx-background-color: transparent; -fx-text-fill: #ff6b6b; -fx-font-size: 14px; -fx-cursor: hand;" />
        </HBox>
    </VBox>

    <!-- Zone des messages -->
    <ListView fx:id="chatListView" AnchorPane.topAnchor="55" AnchorPane.bottomAnchor="70" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10"
              style="-fx-background-color: #f4f7f6; -fx-background-radius: 10; -fx-border-color: transparent;" />

    <!-- Zone de saisie -->
    <HBox spacing="10.0" AnchorPane.bottomAnchor="15" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">
        <TextField fx:id="messageField" promptText="Posez votre question..." HBox.hgrow="ALWAYS"
                   style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 8 15; -fx-border-color: #D4AF37; -fx-border-radius: 20;" />
        <Button text="Envoyer" onAction="#sendMessage"
                style="-fx-background-color: #D4AF37; -fx-text-fill: #1a1a2e; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 15; -fx-cursor: hand;" />
    </HBox>
</AnchorPane>
