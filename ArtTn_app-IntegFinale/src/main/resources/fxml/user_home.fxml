<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="mainContainer" prefHeight="800.0" prefWidth="1200.0"
            style="-fx-background-color: #F8F5F0;"
            stylesheets="@../css/style.css, @../css/front.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.museum.controllers.UserHomeController">

    <top>
        <VBox spacing="0">
            <children>
                <!-- TOP HEADER -->
                <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #1a1a2e; -fx-padding: 10 30;">
                    <children>
                        <Label text="🏛️ MUSEUM DIGITAL" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 18px;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <TextField fx:id="searchFieldHeader" promptText="🔍 Rechercher..." prefWidth="350.0" prefHeight="35.0" style="-fx-background-radius: 20; -fx-padding: 0 15; -fx-background-color: white; -fx-font-size: 14px;" />
                                <Button onAction="#handleOpenCart" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="🛒">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Button>
                                <Label fx:id="cartBadge" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 50%; -fx-padding: 2px 6px;" text="0" visible="false" />
                                <Button onAction="#handleOpenOrders" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="📋">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Button>
                                <StackPane onMouseClicked="#handleShowProfilePage" style="-fx-cursor: hand;">
                                    <Circle radius="18.0" fill="#d4af37" />
                                    <Circle radius="16.0" fill="white" />
                                    <ImageView fx:id="topProfileImageView" fitHeight="30.0" fitWidth="30.0" preserveRatio="true">
                                        <clip>
                                            <Circle radius="15.0" centerX="15.0" centerY="15.0" />
                                        </clip>
                                    </ImageView>
                                </StackPane>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- NAVIGATION BAR -->
                <HBox fx:id="navbarContainer" alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-padding: 8 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <children>
                        <Button onAction="#handleShowHome" styleClass="menu-button-active" text="🏠 Accueil" userData="nav.home" />
                        <Button onAction="#handleShowBoutique" styleClass="menu-button" text="🛍️ Boutique" userData="nav.boutique" />
                        <Button onAction="#handleShowForum" styleClass="menu-button" text="💬 Forum" userData="nav.forum" />
                        <Separator orientation="VERTICAL" prefHeight="20.0" />
                        <Button onAction="#handleShowJobFront" styleClass="menu-button" text="💼 Offres d'Emploi" userData="nav.jobs" />
                        <Button onAction="#handleShowEventsFront" styleClass="menu-button" text="🎭 Événements" userData="nav.events" />
                        <Button onAction="#handleShowMesCandidatures" styleClass="menu-button" text="📋 Mes Candidatures" userData="nav.candidatures" />
                        <Region HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="navLanguageCombo"
                                  style="-fx-background-color: #f8f8f8; -fx-border-color: #D4AF37;
                                         -fx-border-radius: 8; -fx-background-radius: 8;
                                         -fx-font-size: 12px; -fx-cursor: hand;"
                                  prefWidth="145" />
                        <Button onAction="#handleLogout" styleClass="menu-button" style="-fx-text-fill: #e74c3c;" text="🚪 Déconnexion" userData="nav.logout" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <StackPane>
                    <children>
                        <!-- VUE ACCUEIL -->
                        <VBox fx:id="homeView" spacing="0" visible="true" managed="true">

                            <!-- HERO BANNER -->
                            <StackPane prefHeight="380.0">
                                <ImageView fitHeight="380.0" fitWidth="1140.0" preserveRatio="false">
                                    <Image url="@../images/login_image.png" />
                                </ImageView>
                                <VBox alignment="CENTER" spacing="18.0"
                                      style="-fx-background-color: rgba(10,10,30,0.65);">
                                    <Label fx:id="welcomeLabel" text="Bienvenue dans l'Histoire"
                                           textFill="#D4AF37"
                                           style="-fx-font-size: 46px; -fx-font-weight: bold;" />
                                    <Label fx:id="heroSubtitleLabel" text="Découvrez les trésors du patrimoine national"
                                           textFill="WHITE"
                                           style="-fx-font-size: 20px;" />
                                    <HBox alignment="CENTER" spacing="15.0">
                                        <Button fx:id="heroBtnEvents" onAction="#handleShowEventsFront"
                                                prefHeight="48.0" prefWidth="210.0"
                                                style="-fx-background-color: #D4AF37; -fx-background-radius: 25;
                                                       -fx-font-weight: bold; -fx-font-size: 14px;
                                                       -fx-text-fill: #1a1a2e; -fx-cursor: hand;"
                                                text="🎭 Voir les Événements" />
                                        <Button fx:id="heroBtnShop" onAction="#handleShowBoutique"
                                                prefHeight="48.0" prefWidth="210.0"
                                                style="-fx-background-color: transparent;
                                                       -fx-border-color: white; -fx-border-radius: 25;
                                                       -fx-border-width: 2; -fx-background-radius: 25;
                                                       -fx-font-weight: bold; -fx-font-size: 14px;
                                                       -fx-text-fill: white; -fx-cursor: hand;"
                                                text="🛍️ Explorer la Boutique" />
                                    </HBox>
                                </VBox>
                            </StackPane>

                            <!-- STATS BAND -->
                            <HBox alignment="CENTER" spacing="0"
                                  style="-fx-background-color: #1a1a2e; -fx-padding: 22 60;">
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="4.0">
                                    <Label fx:id="statEventsLabel" text="—"
                                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #D4AF37;" />
                                    <Label fx:id="statEventsTextLabel" text="Événements à venir"
                                           style="-fx-font-size: 13px; -fx-text-fill: #a0a0b0;" />
                                </VBox>
                                <Separator orientation="VERTICAL" style="-fx-background-color: #333355;" prefHeight="50.0" />
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="4.0">
                                    <Label fx:id="statProductsLabel" text="—"
                                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #D4AF37;" />
                                    <Label fx:id="statProductsTextLabel" text="Produits disponibles"
                                           style="-fx-font-size: 13px; -fx-text-fill: #a0a0b0;" />
                                </VBox>
                                <Separator orientation="VERTICAL" style="-fx-background-color: #333355;" prefHeight="50.0" />
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="4.0">
                                    <Label text="3"
                                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #D4AF37;" />
                                    <Label fx:id="statMuseumsTextLabel" text="Musées partenaires"
                                           style="-fx-font-size: 13px; -fx-text-fill: #a0a0b0;" />
                                </VBox>
                                <Separator orientation="VERTICAL" style="-fx-background-color: #333355;" prefHeight="50.0" />
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="4.0">
                                    <Label text="100%"
                                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #D4AF37;" />
                                    <Label fx:id="statDigitalTextLabel" text="Patrimoine numérique"
                                           style="-fx-font-size: 13px; -fx-text-fill: #a0a0b0;" />
                                </VBox>
                            </HBox>

                            <!-- SECTION ÉVÉNEMENTS -->
                            <VBox spacing="20.0" style="-fx-padding: 40 50 30 50; -fx-background-color: #F8F5F0;">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox spacing="4.0">
                                        <Label fx:id="sectionEventsTitleLabel" text="🎭 Événements à Venir"
                                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                                        <Label fx:id="sectionEventsSubLabel" text="Réservez votre place pour nos prochains événements culturels"
                                               style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" />
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnAllEvents" onAction="#handleShowEventsFront"
                                            style="-fx-background-color: #1a1a2e; -fx-text-fill: #D4AF37;
                                                   -fx-background-radius: 20; -fx-font-weight: bold;
                                                   -fx-padding: 8 20; -fx-cursor: hand;"
                                            text="Voir tous →" />
                                </HBox>
                                <HBox fx:id="homeEventsContainer" spacing="20.0"
                                      style="-fx-padding: 5 0 10 0;" fillHeight="true" alignment="CENTER_LEFT" />
                            </VBox>

                            <!-- SECTION PRODUITS -->
                            <VBox spacing="20.0" style="-fx-padding: 30 50 40 50; -fx-background-color: white;">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox spacing="4.0">
                                        <Label fx:id="sectionShopTitleLabel" text="🛍️ Notre Boutique"
                                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                                        <Label fx:id="sectionShopSubLabel" text="Souvenirs, livres et objets d'art du patrimoine tunisien"
                                               style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" />
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnAllShop" onAction="#handleShowBoutique"
                                            style="-fx-background-color: #1a1a2e; -fx-text-fill: #D4AF37;
                                                   -fx-background-radius: 20; -fx-font-weight: bold;
                                                   -fx-padding: 8 20; -fx-cursor: hand;"
                                            text="Voir tous →" />
                                </HBox>
                                <HBox fx:id="homeProductsContainer" spacing="20.0"
                                      style="-fx-padding: 5 0 10 0;" fillHeight="true" alignment="CENTER_LEFT" />
                            </VBox>

                            <!-- SECTION À PROPOS -->
                            <HBox spacing="0" style="-fx-background-color: #1a1a2e;">
                                <VBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="18.0"
                                      style="-fx-padding: 50 60;">
                                    <Label fx:id="aboutTitleLabel" text="À propos de Museum Digital"
                                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #D4AF37;" />
                                    <Label fx:id="aboutTextLabel" text="Museum Digital est la plateforme nationale dédiée à la valorisation du patrimoine culturel tunisien."
                                           style="-fx-text-fill: #c0c0d0; -fx-font-size: 13px; -fx-line-spacing: 4;"
                                           wrapText="true" />
                                    <HBox spacing="30.0" style="-fx-padding: 10 0 0 0;">
                                        <VBox spacing="4.0">
                                            <Label text="✅" style="-fx-font-size: 20px;" />
                                            <Label fx:id="feat1Label" text="Réservation en ligne" style="-fx-text-fill: white; -fx-font-size: 12px;" />
                                        </VBox>
                                        <VBox spacing="4.0">
                                            <Label text="🎟️" style="-fx-font-size: 20px;" />
                                            <Label fx:id="feat2Label" text="Billets numériques" style="-fx-text-fill: white; -fx-font-size: 12px;" />
                                        </VBox>
                                        <VBox spacing="4.0">
                                            <Label text="🛍️" style="-fx-font-size: 20px;" />
                                            <Label fx:id="feat3Label" text="Boutique officielle" style="-fx-text-fill: white; -fx-font-size: 12px;" />
                                        </VBox>
                                        <VBox spacing="4.0">
                                            <Label text="💬" style="-fx-font-size: 20px;" />
                                            <Label fx:id="feat4Label" text="Forum communautaire" style="-fx-text-fill: white; -fx-font-size: 12px;" />
                                        </VBox>
                                    </HBox>
                                </VBox>
                                <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="15.0"
                                      style="-fx-padding: 50 60; -fx-background-color: #16213e;">
                                    <Label fx:id="contactTitleLabel" text="Nous contacter"
                                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #D4AF37;" />
                                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                                        <Label text="📧" style="-fx-font-size: 16px;" />
                                        <Label text="contact@museumdigital.tn"
                                               style="-fx-text-fill: #c0c0d0; -fx-font-size: 13px;" />
                                    </HBox>
                                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                                        <Label text="📞" style="-fx-font-size: 16px;" />
                                        <Label text="+216 71 000 000"
                                               style="-fx-text-fill: #c0c0d0; -fx-font-size: 13px;" />
                                    </HBox>
                                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                                        <Label text="📍" style="-fx-font-size: 16px;" />
                                        <Label text="Tunis, Tunisie"
                                               style="-fx-text-fill: #c0c0d0; -fx-font-size: 13px;" />
                                    </HBox>
                                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                                        <Label text="🕐" style="-fx-font-size: 16px;" />
                                        <Label text="Lun–Ven : 9h00 – 17h00"
                                               style="-fx-text-fill: #c0c0d0; -fx-font-size: 13px;" />
                                    </HBox>
                                </VBox>
                            </HBox>

                            <!-- FOOTER -->
                            <HBox alignment="CENTER" prefHeight="55.0"
                                  style="-fx-background-color: #0d0d1a; -fx-padding: 0 30;">
                                <Label fx:id="footerLabel" text="© 2026 Museum Digital — Tous droits réservés · Patrimoine National de Tunisie"
                                       style="-fx-text-fill: #555570; -fx-font-size: 12px;" />
                            </HBox>

                        </VBox>

                        <!-- VUE BOUTIQUE (PRODUITS) -->
                        <VBox fx:id="productsView" spacing="20.0" style="-fx-padding: 20; -fx-background-color: #f5f5f5;" visible="false" managed="false">
                            <children>
                                <!-- Titre de la boutique -->
                                <Label text="Notre Boutique" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 10 0; text-alignment: center;" maxWidth="1.7976931348623157E308" />

                                <!-- Filtres centrés -->
                                <HBox spacing="15.0" alignment="CENTER">
                                    <children>
                                        <Label text="🔍" style="-fx-font-size: 18px;" />
                                        <TextField fx:id="searchFieldBoutique" promptText="Rechercher un produit..." prefHeight="40.0" prefWidth="400.0" style="-fx-background-radius: 20; -fx-padding: 0 15;" />
                                        <Label text="Catégorie:" style="-fx-font-weight: bold;" />
                                        <ComboBox fx:id="categoryFilter" prefWidth="150.0" prefHeight="35.0" style="-fx-background-radius: 20;" />
                                    </children>
                                </HBox>

                                <!-- Conteneur des produits centrés -->
                                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                                    <content>
                                        <FlowPane fx:id="productsContainer" hgap="25.0" vgap="25.0" alignment="CENTER"
                                                  style="-fx-alignment: center; -fx-background-color: transparent;" />
                                    </content>
                                </ScrollPane>

                                <!-- Footer pour la boutique -->
                                <HBox alignment="CENTER" prefHeight="80.0" style="-fx-background-color: #1a1a2e; -fx-background-radius: 12 12 0 0;">
                                    <children>
                                        <Label text="© 2026 Museum Digital Corporation. L'excellence au service de la culture." textFill="#a0a0a0" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- VUE PROFIL -->
                        <VBox fx:id="profileView"  spacing="20.0" style="-fx-padding: 20; -fx-background-color: #f5f5f5;" visible="false" managed="false">

                        <children>

                                <Label text="👤 Mon Profil"
                                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

                                <Label text="Gérez vos informations personnelles"
                                       textFill="#7f8c8d" />

                                <VBox spacing="25.0"
                                      alignment="CENTER"
                                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                                    <children>

                                        <HBox alignment="CENTER" spacing="25.0">
                                            <children>

                                                <StackPane>
                                                    <Circle radius="55.0" fill="#d4af37" />
                                                    <Circle radius="52.0" fill="white" />

                                                    <ImageView fx:id="profileImageView"
                                                               fitHeight="100.0"
                                                               fitWidth="100.0"
                                                               preserveRatio="true">
                                                        <clip>
                                                            <Circle radius="50.0"
                                                                    centerX="50.0"
                                                                    centerY="50.0" />
                                                        </clip>
                                                    </ImageView>

                                                </StackPane>

                                                <VBox spacing="10.0">
                                                    <children>

                                                        <Button text="📷 Changer la photo"
                                                                onAction="#handleChangeProfilePicture"
                                                                style="-fx-background-color: #d4af37; -fx-background-radius: 20; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-cursor: hand;" />

                                                        <Label text="Formats: PNG, JPG, JPEG (max 5MB)"
                                                               style="-fx-text-fill: #999; -fx-font-size: 11px;" />

                                                    </children>
                                                </VBox>

                                            </children>
                                        </HBox>

                                        <Separator />

                                        <Label text="Informations personnelles"
                                               style="-fx-font-weight: bold; -fx-font-size: 16px;" />

                                        <GridPane hgap="20.0" vgap="15.0" alignment="CENTER">
                                            <columnConstraints>
                                                <ColumnConstraints prefWidth="150.0" />
                                                <ColumnConstraints prefWidth="350.0" />
                                            </columnConstraints>

                                            <children>

                                                <Label text="Nom complet:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;" />
                                                <TextField fx:id="fullNameField" GridPane.columnIndex="1" GridPane.rowIndex="0" prefHeight="40.0" />

                                                <Label text="Nom d'utilisateur:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;" />
                                                <TextField fx:id="usernameField" GridPane.columnIndex="1" GridPane.rowIndex="1" prefHeight="40.0" />

                                                <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;" />
                                                <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="2" prefHeight="40.0" />

                                            </children>
                                        </GridPane>

                                        <Separator />

                                        <Label text="Changer le mot de passe"
                                               style="-fx-font-weight: bold; -fx-font-size: 16px;" />

                                        <GridPane hgap="20.0" vgap="15.0" alignment="CENTER">
                                            <columnConstraints>
                                                <ColumnConstraints prefWidth="150.0" />
                                                <ColumnConstraints prefWidth="350.0" />
                                            </columnConstraints>

                                            <children>

                                                <Label text="Nouveau mot de passe:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;" />
                                                <PasswordField fx:id="newPasswordField" GridPane.columnIndex="1" GridPane.rowIndex="0" prefHeight="40.0" promptText="Laisser vide pour ne pas changer" />

                                                <Label text="Confirmer:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;" />
                                                <PasswordField fx:id="confirmPasswordField" GridPane.columnIndex="1" GridPane.rowIndex="1" prefHeight="40.0" promptText="Confirmer le nouveau mot de passe" />

                                            </children>
                                        </GridPane>

                                        <Label fx:id="profileMessageLabel" visible="false" />

                                        <HBox spacing="15.0" alignment="CENTER_LEFT">
                                            <children>

                                                <Button text="Annuler"
                                                        onAction="#handleCancel"
                                                        style="-fx-background-color: transparent; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-text-fill: #666; -fx-cursor: hand;" />

                                                <Button text="💾 Enregistrer"
                                                        onAction="#handleSaveChanges"
                                                        style="-fx-background-color: #27ae60; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />

                                            </children>
                                        </HBox>

                                    </children>

                                </VBox>

                            </children>

                        </VBox>
                        <VBox fx:id="forumView" id="forumView" spacing="20.0" visible="false" managed="false" maxWidth="Infinity" maxHeight="Infinity" />
                        <VBox fx:id="jobFrontView" spacing="20.0" visible="false" managed="false" maxWidth="Infinity" maxHeight="Infinity" />
                        <VBox fx:id="favoriteOffersView" spacing="20.0" visible="false" managed="false" maxWidth="Infinity" maxHeight="Infinity" />
                        <VBox fx:id="eventsFrontView" spacing="20.0" visible="false" managed="false" maxWidth="Infinity" maxHeight="Infinity" />
                        <VBox fx:id="mesCandidaturesView" spacing="20.0" visible="false" managed="false" maxWidth="Infinity" maxHeight="Infinity" />
                        <VBox fx:id="mesReservationsView" spacing="20.0" visible="false" managed="false" maxWidth="Infinity" maxHeight="Infinity" />
                        <VBox fx:id="userDonationsView" spacing="20.0" visible="false" managed="false" maxWidth="Infinity" maxHeight="Infinity" />
                    </children>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
