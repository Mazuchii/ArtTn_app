<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.museum.controllers.ProductsViewController">

    <!-- TOP BAR -->
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: linear-gradient(to right, #1a1a2e, #16213e); -fx-padding: 15;">
                <children>
                    <Label text="🏛️ MUSEUM DIGITAL" textFill="white">
                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>
                    </Label>
                    <Label text="| Boutique" textFill="#d4af37">
                        <font>
                            <Font size="16.0" />
                        </font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />

                    <!-- Panier -->
                    <HBox alignment="CENTER" spacing="5.0">
                        <children>
                            <Button onAction="#handleOpenCart" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="🛒 Panier" />
                            <Label fx:id="cartBadge" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 50%; -fx-padding: 2px 6px;" text="0" visible="false" />
                        </children>
                    </HBox>

                    <!-- Historique -->
                    <Button onAction="#handleOpenOrders" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="📋 Mes commandes" />
                </children>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER -->
    <center>
        <VBox spacing="20.0" style="-fx-padding: 20; -fx-background-color: #f5f5f5;">
            <children>

                <!-- Filtres -->
                <HBox spacing="15.0" alignment="CENTER_LEFT">
                    <children>
                        <Label text="🔍" style="-fx-font-size: 18px;" />
                        <TextField fx:id="searchField" promptText="Rechercher un produit..." prefHeight="40.0" prefWidth="300.0" style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 0 15;" />
                        <Label text="Catégorie:" style="-fx-font-weight: bold;" />
                        <ComboBox fx:id="categoryFilter" prefWidth="150.0" prefHeight="35.0" style="-fx-background-radius: 20;" />
                    </children>
                </HBox>

                <!-- Produits -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <content>
                        <FlowPane fx:id="productsContainer" hgap="20.0" vgap="20.0" alignment="TOP_CENTER" />
                    </content>
                </ScrollPane>

            </children>
        </VBox>
    </center>

</BorderPane>
